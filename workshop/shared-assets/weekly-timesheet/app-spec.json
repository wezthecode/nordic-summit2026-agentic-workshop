{
  "solution": { "uniqueName": "AgenticTimesheet", "displayName": "Agentic Timesheet", "publisherPrefix": "cre" },
  "app": { "name": "Weekly Timesheet", "description": "Log and review weekly time entries against active projects. Record CRUD only — no dashboards or analytics surfaces are needed for this app." },
  "personas": [
    {
      "persona": "Timesheet User",
      "jobs": [
        {
          "name": "Log and manage my own time entries",
          "surfaces": ["Time Entry", "My Time Entries"],
          "privileges": [
            { "entity": "cre_timeentry", "access": ["create", "read", "write", "delete", "append", "appendTo"], "scope": "user" },
            { "entity": "cre_project", "access": ["read", "appendTo"], "scope": "organization" }
          ]
        }
      ]
    }
  ],
  "entities": [
    {
      "schemaName": "cre_project",
      "displayName": "Project",
      "pluralName": "Projects",
      "primaryAttribute": { "schemaName": "cre_name", "displayName": "Name" },
      "columns": [
        { "schemaName": "cre_code", "displayName": "Code", "type": "Text", "maxLength": 20, "required": true },
        { "schemaName": "cre_isactive", "displayName": "Is Active", "type": "Boolean", "trueLabel": "Yes", "falseLabel": "No", "defaultValue": true, "required": true }
      ]
    },
    {
      "schemaName": "cre_timeentry",
      "displayName": "Time Entry",
      "pluralName": "Time Entries",
      "primaryAttribute": { "schemaName": "cre_name", "displayName": "Summary" },
      "columns": [
        { "schemaName": "cre_date", "displayName": "Date", "type": "DateTime", "dateFormat": "DateOnly", "required": true },
        { "schemaName": "cre_hours", "displayName": "Hours", "type": "Decimal", "minValue": 0.25, "maxValue": 24, "precision": 1, "required": true },
        { "schemaName": "cre_description", "displayName": "Description", "type": "Memo" },
        { "schemaName": "cre_source", "displayName": "Source", "type": "Choice", "options": ["Manual", "Copilot Studio agent", "Foundry agent"], "required": true },
        { "schemaName": "cre_calendareventid", "displayName": "Calendar Event ID", "type": "Text", "maxLength": 200 }
      ],
      "alternateKeys": [
        { "schemaName": "cre_uniquecalendarevent", "displayName": "Unique Calendar Event", "columns": ["cre_calendareventid"] }
      ]
    }
  ],
  "relationships": [
    {
      "type": "OneToMany",
      "referenced": "cre_project",
      "referencing": "cre_timeentry",
      "lookup": { "schemaName": "cre_ProjectId", "displayName": "Project", "required": true }
    }
  ],
  "forms": [
    {
      "entity": "cre_timeentry",
      "type": "main",
      "name": "Time Entry",
      "layout": "auto"
    },
    {
      "entity": "cre_project",
      "type": "main",
      "name": "Project",
      "layout": "auto"
    }
  ],
  "views": [
    {
      "entity": "cre_timeentry",
      "type": "main",
      "name": "My Time Entries - This Week",
      "columns": ["cre_name", "cre_date", "cre_projectid", "cre_hours", "cre_source"],
      "sort": [{ "attr": "cre_date", "dir": "desc" }]
    },
    {
      "entity": "cre_project",
      "type": "main",
      "name": "Projects - Active",
      "columns": ["cre_name", "cre_code", "cre_isactive"],
      "sort": [{ "attr": "cre_name", "dir": "asc" }],
      "activeOnly": true
    }
  ],
  "appShell": {
    "areas": [
      {
        "label": "Timesheet",
        "groups": [
          {
            "label": "Time Tracking",
            "subAreas": [
              { "entity": "cre_timeentry", "title": "Time Entries" },
              { "entity": "cre_project", "title": "Projects" }
            ]
          }
        ]
      }
    ]
  }
}
